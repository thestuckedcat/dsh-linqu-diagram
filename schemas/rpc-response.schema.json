{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "view_epoch",
        "scope_generation",
        "status",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
        },
        "view_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scope_generation": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "const": "ok"
        },
        "data": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "view_epoch",
        "scope_generation",
        "status",
        "reason_code"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
        },
        "view_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scope_generation": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "denied",
            "stale",
            "invalid",
            "conflict",
            "unavailable",
            "failed"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_version"
          ],
          "properties": {
            "current_version": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "document_id",
                "generation",
                "content_sha256",
                "byte_length",
                "path_identity_digest"
              ],
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "document_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
                },
                "generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "byte_length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10485760
                },
                "path_identity_digest": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "not": {
                    "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                  }
                }
              }
            },
            "draft_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
            }
          }
        }
      }
    }
  ]
}
