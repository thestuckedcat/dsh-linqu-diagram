{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "contexts",
    "documents",
    "output_roots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "contexts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_ref",
          "scope_ref",
          "scope_generation",
          "active"
        ],
        "properties": {
          "context_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
          },
          "scope_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
            }
          },
          "scope_generation": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_ref",
          "document_id",
          "scope_ref",
          "scope_generation",
          "path_identity_digest",
          "mode",
          "active"
        ],
        "properties": {
          "document_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
          },
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
          },
          "scope_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
            }
          },
          "scope_generation": {
            "type": "integer",
            "minimum": 0
          },
          "path_identity_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
            }
          },
          "mode": {
            "enum": [
              "read",
              "edit"
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "output_roots": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output_ref",
          "scope_ref",
          "scope_generation",
          "identity_digest",
          "active"
        ],
        "properties": {
          "output_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
          },
          "scope_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
            }
          },
          "scope_generation": {
            "type": "integer",
            "minimum": 0
          },
          "identity_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
            }
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
