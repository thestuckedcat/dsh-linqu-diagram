{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "generation",
    "content_sha256",
    "byte_length",
    "path_identity_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    },
    "path_identity_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
      }
    }
  }
}
