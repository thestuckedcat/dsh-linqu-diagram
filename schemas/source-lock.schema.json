{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "commands",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "package_manager"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
          }
        },
        "tested_node": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "not": {
                "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
              }
            }
          ]
        },
        "tested_node_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "host_node": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "not": {
                "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
              }
            }
          ]
        },
        "package_manager": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
          }
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
          }
        },
        "electron": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "not": {
                "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
              }
            }
          ]
        },
        "host_protocol_version": {
          "type": "integer",
          "minimum": 0
        },
        "app_asar_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "installed_checkout": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
          }
        },
        "verified_interfaces": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "sha256",
              "mechanism",
              "adopted"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                }
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                ]
              },
              "mechanism": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                }
              },
              "adopted": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "repository",
          "commit",
          "version",
          "package",
          "artifact_sha256",
          "license",
          "license_ref",
          "adopted_files",
          "resource_manifest_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
            }
          },
          "commit": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{7,64}$"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                }
              }
            ]
          },
          "package": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                }
              }
            ]
          },
          "artifact_sha256": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "license": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                }
              }
            ]
          },
          "license_ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                }
              }
            ]
          },
          "adopted_files": {
            "type": "array",
            "minItems": 0,
            "maxItems": 1024,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "not": {
                "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
              }
            }
          },
          "resource_manifest_ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                }
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
                }
              }
            ]
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "executable_ref",
          "args_template",
          "env_fixed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~=-]*$"
          },
          "executable_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
            }
          },
          "args_template": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1024,
              "not": {
                "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
              }
            }
          },
          "env_fixed": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 1024
            }
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "not": {
          "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_mode"
      ],
      "properties": {
        "network_mode": {
          "const": "none"
        },
        "remote_services": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
            }
          }
        },
        "model_services": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]"
            }
          }
        },
        "credential_access": {
          "type": "boolean"
        }
      }
    }
  }
}
