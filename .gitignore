# 06 local diagrams - repository ignore rules

# Test / smoke scratch output (regenerated by tools)
/scratch-output/
/scratch/
/scratch-*/
*.tmp
*.tap
*.log

# Local secrets, drafts and generated runtime registries (never committed)
/.local/
/drafts/
/documents/
/registry.json

# Editor caches
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node
node_modules/
npm-debug.log*

# Local offline runtime (large binary, not committed; see runtime/README.md)
/runtime/node.exe
/runtime/node
